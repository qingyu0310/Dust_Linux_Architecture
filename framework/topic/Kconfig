# topic/Kconfig —— 线程间数据通道契约。
# 架构层能力默认 n，由业务层 select 拉起。

config DUST_TPC_CAMERA_TO
    bool "camera frame channel"
    default n
    help
      Single-slot camera frame channel (topic/camera_to).

config DUST_TPC_VISION_TO
    bool "vision result channel"
    default n
    help
      Single-slot vision result channel (topic/vision_to).
